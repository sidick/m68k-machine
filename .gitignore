/target/
**/target/
*.swp
.DS_Store

# amibake build outputs, if ever built inside the tree. They contain
# licensed AmigaOS media and must never be committed — see
# tools/amibake/m68k-machine.toml and docs/storage.md.
*.hdf
*.hdz
/tools/amibake/out/

# Licensed media that tests need but this repo may not carry: Kickstart
# ROMs and built AmigaOS images. Ignored wholesale so nothing in here can
# be committed by accident, with only the README explaining what belongs.
/nondistribution/*
!/nondistribution/README.md

# amibake's content-addressed download/layer cache. It defaults to the
# working directory, so a build run from the repo root drops ~90 MB here
# -- including the licensed AmigaOS base layers, which must never be
# committed for exactly the reasons nondistribution/README.md gives.
# Ignored rather than merely remembered: it was committed once by a
# `git add -A`, which is precisely the accident an ignore rule exists to
# make impossible.
/.amibake-cache/
